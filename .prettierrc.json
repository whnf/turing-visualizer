{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/components/ui/",
    "",
    "^@/components/",
    "",
    "^@/(?!components/|store/)",
    "",
    "^@/store/",
    "",
    "^[./]"
  ],
  "importOrderTypeScriptVersion": "5.0.0",
  "tailwindStylesheet": "./src/index.css",
  "tailwindFunctions": ["cn", "cva"]
}
